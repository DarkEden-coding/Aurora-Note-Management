# Example environment for `docker compose up` with Aurora. Copy to `.env` and adjust.
# PostgreSQL credentials used by the db service and the app's DATABASE_URL.
POSTGRES_USER=aurora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=aurora

# Aurora has no login: anyone who can reach it is the owner. Expose it only
# through Tailscale Serve (tailnet only). AURORA_ORIGIN must be the origin you
# browse, e.g. https://<host>.<tailnet>.ts.net:8443; requests from other sites
# are rejected. Non-localhost origins need HTTPS (Tailscale Serve provides it).
AURORA_ORIGIN=http://localhost:8080

# Loopback port that exposes the app (the container always listens on 8787).
AURORA_PORT=8080

# Optional: platform API key fallback for the chat agent if ChatGPT is not linked.
# OPENAI_API_KEY=
# AURORA_AI_MODEL=gpt-5.5
