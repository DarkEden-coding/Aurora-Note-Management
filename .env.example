# Example environment for `docker compose up` with Aurora. Copy to `.env` and adjust.
# PostgreSQL credentials used by the db service and the app's DATABASE_URL.
POSTGRES_USER=aurora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=aurora

# Cookie signing secret for sessions; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AURORA_COOKIE_SECRET=replace-with-at-least-32-random-bytes-xxxxxxxxxxxx

# WebAuthn binding: AURORA_ORIGIN must be the origin users browse, and
# AURORA_RP_ID must be a registrable domain suffix of its hostname.
# localhost works over plain HTTP for local self-hosting; other hosts need TLS
# (terminate it in a reverse proxy that forwards to the app service).
AURORA_RP_ID=localhost
AURORA_ORIGIN=http://localhost:8080
AURORA_RP_NAME=Aurora

# Host port that exposes the app (the container always listens on 8787).
AURORA_PORT=8080

# Optional: fix the one-time enrollment token instead of the auto-generated one.
# AURORA_SETUP_TOKEN=
