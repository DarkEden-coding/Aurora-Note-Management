# Example environment for Aurora's authoritative server; copy to .env under apps/server and adjust per deployment.
NODE_ENV=development
AURORA_HOST=127.0.0.1
AURORA_PORT=8787
DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora
# Cookie signing secret; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AURORA_COOKIE_SECRET=replace-with-at-least-32-random-bytes-xxxxxxxxxxxx
AURORA_SESSION_COOKIE_NAME=aurora_session
AURORA_SESSION_TTL_DAYS=30
AURORA_UPLOAD_DIR=.data/uploads
# Optional: directory of the built web app to serve statically (single-image deploys).
# AURORA_WEB_DIST=../web/dist
AURORA_MAX_UPLOAD_BYTES=26214400
AURORA_RP_ID=localhost
AURORA_RP_NAME=Aurora
AURORA_ORIGIN=http://localhost:8787
AURORA_LOG_LEVEL=info
# Retention windows (days) for the cleanup job; trash and snapshots follow the 30-day policy.
AURORA_TRASH_RETENTION_DAYS=30
AURORA_SESSION_RETENTION_DAYS=30
AURORA_OPERATION_RETENTION_DAYS=30
AURORA_SNAPSHOT_RETENTION_DAYS=30
# Optional: pre-provision the one-time enrollment token instead of letting startup generate one.
# AURORA_SETUP_TOKEN=
